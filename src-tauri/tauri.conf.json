{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pluryprint",
  "identifier": "com.maecly.pluryprint",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pluryprint",
        "width": 1080,
        "height": 680,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/64x64.png",
      "icons/icon.png"
    ],
    "resources": {
      "resources/sumatrapdf/*": "resources/sumatrapdf/",
      "resources/shellext/": "resources/shellext/",
      "../LICENSE": "LICENSE",
      "../LICENSES/*": "LICENSES/",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "category": "Productivity",
    "shortDescription": "Batch file printing",
    "longDescription": "Open source batch file printing for Windows, macOS and Linux. Right-click and print everything, with no 15-file limit, no Adobe required, and no $149 license fee.",
    "copyright": "Copyright (C) 2026 Maecly. Licensed under AGPL-3.0-only.",
    "publisher": "Maecly",
    "homepage": "https://pluryprint.maecly.com",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "files": {
        "Resources/en.lproj/ServicesMenu.strings": "macos/en.lproj/ServicesMenu.strings",
        "Resources/es.lproj/ServicesMenu.strings": "macos/es.lproj/ServicesMenu.strings"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["cups-client"],
        "recommends": ["cups-ipp-utils", "libheif-examples"],
        "desktopTemplate": "linux/pluryprint.desktop.hbs",
        "files": {
          "/usr/share/kio/servicemenus/pluryprint.desktop": "linux/kio-servicemenu.desktop",
          "/usr/share/nemo/actions/pluryprint-print-now.nemo_action": "linux/nemo/pluryprint-print-now.nemo_action",
          "/usr/share/nemo/actions/pluryprint-configure.nemo_action": "linux/nemo/pluryprint-configure.nemo_action",
          "/usr/share/nemo/actions/pluryprint-queue.nemo_action": "linux/nemo/pluryprint-queue.nemo_action"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2QzEyMUFDRjJBNzk5MTUKUldRVm1hZnlyQ0hCUm1uMHVxSnhHVXlGaWd3NW9oakdUeGplQTllbDYvZEdsb05ybnlYZUZCN28K",
      "endpoints": [
        "https://github.com/MAECLY/pluryprint/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
