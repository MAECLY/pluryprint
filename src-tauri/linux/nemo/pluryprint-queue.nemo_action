# Nemo (Cinnamon) action: adds the selection to the queue without starting it.
# Installed by the .deb at
# /usr/share/nemo/actions/pluryprint-queue.nemo_action. Nemo has no
# system-wide submenus, so the three actions sit at the top level and name
# Pluryprint themselves.
#
# Extensions= rather than Mimetypes=: Nemo matches a MIME type together with
# its subclasses, and text/plain would then offer the action on every source
# file and log. Entries keep their leading dot because Nemo compares them as a
# plain suffix ("md" would match "cmd"). Every selected item must match, and
# "dir" lets folders through. `shell_menu::linux_files` tests keep the list in
# step with the engine.

[Nemo Action]
Name=Add to the Pluryprint print queue
Name[es]=Añadir a la cola de impresión de Pluryprint
Comment=Add the selected files to the queue without printing them yet
Comment[es]=Añade los archivos seleccionados a la cola sin imprimirlos todavía
Exec=pluryprint --invoke=context-menu --action=queue -- %F
Icon-Name=view-list-details
Selection=notnone
Extensions=dir;.pdf;.jpg;.jpeg;.png;.tif;.tiff;.bmp;.webp;.heic;.heif;.svg;.svgz;.docx;.doc;.xlsx;.xls;.pptx;.ppt;.odt;.ods;.odp;.rtf;.txt;.html;.htm;.md;.markdown;
Dependencies=pluryprint;
